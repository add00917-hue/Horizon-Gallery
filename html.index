<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Horizon Gallery</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:       #16181d;
  --sidebar:  #1c1f26;
  --card:     #22252e;
  --border:   rgba(255,255,255,.07);
  --teal:     #2dd4bf;
  --teal-dim: rgba(45,212,191,.12);
  --text:     #f0f0f0;
  --muted:    #6b7280;
  --muted2:   #9ca3af;
  --sidebar-w: 240px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  font-weight: 400;
  height: 100vh;
  display: flex;
  overflow: hidden;
}

/* ─── Sidebar ────────────────────────────────── */
#sidebar {
  width: var(--sidebar-w);
  height: 100vh;
  background: var(--sidebar);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  padding: 24px 0;
  flex-shrink: 0;
  position: relative;
  z-index: 10;
}

.sb-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 20px 24px;
  border-bottom: 1px solid var(--border);
}
.sb-brand-icon {
  width: 32px; height: 32px;
  background: linear-gradient(135deg, var(--teal), #0891b2);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.sb-brand-icon svg { width: 16px; height: 16px; }
.sb-brand-name {
  font-family: 'DM Serif Display', serif;
  font-size: 15px;
  color: var(--text);
  letter-spacing: .3px;
}

.sb-section { padding: 20px 12px 8px; }
.sb-section-label {
  font-size: 10px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--muted);
  padding: 0 8px;
  margin-bottom: 6px;
}

.sb-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  border-radius: 10px;
  cursor: pointer;
  font-size: 13.5px;
  color: var(--muted2);
  transition: all .18s;
  position: relative;
  user-select: none;
}
.sb-item:hover { background: rgba(255,255,255,.05); color: var(--text); }
.sb-item.active {
  background: var(--teal-dim);
  color: var(--teal);
}
.sb-item.active .sb-icon { color: var(--teal); }
.sb-icon { width: 16px; height: 16px; flex-shrink: 0; opacity: .7; }
.sb-item.active .sb-icon { opacity: 1; }
.sb-badge {
  margin-left: auto;
  background: var(--teal);
  color: #000;
  font-size: 10px;
  font-weight: 600;
  padding: 1px 6px;
  border-radius: 20px;
  min-width: 20px;
  text-align: center;
}

.sb-divider { height: 1px; background: var(--border); margin: 8px 20px; }

.sb-footer {
  margin-top: auto;
  padding: 0 12px;
}
.sb-user {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  cursor: pointer;
  transition: background .18s;
}
.sb-user:hover { background: rgba(255,255,255,.05); }
.sb-avatar {
  width: 32px; height: 32px;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 600; color: #fff; flex-shrink: 0;
}
.sb-username { font-size: 13px; color: var(--muted2); }
.sb-user-dots { margin-left: auto; color: var(--muted); font-size: 16px; letter-spacing: 1px; }

/* ─── Main ──────────────────────────────────── */
#main {
  flex: 1;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Topbar */
#topbar {
  padding: 24px 32px 0;
  flex-shrink: 0;
}
.tb-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 4px;
}
.tb-title {
  font-family: 'DM Serif Display', serif;
  font-size: 32px;
  font-weight: 400;
  color: var(--text);
  letter-spacing: -.3px;
}
.tb-actions { display: flex; align-items: center; gap: 10px; }
.btn-ghost {
  display: flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,.07);
  border: 1px solid var(--border);
  color: var(--muted2);
  padding: 8px 14px;
  border-radius: 10px;
  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  cursor: pointer;
  transition: all .18s;
}
.btn-ghost:hover { background: rgba(255,255,255,.12); color: var(--text); }
.btn-primary {
  display: flex; align-items: center; gap: 6px;
  background: var(--teal);
  border: none;
  color: #0a1a18;
  padding: 8px 16px;
  border-radius: 10px;
  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all .18s;
}
.btn-primary:hover { background: #5eead4; }

.tb-sub {
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 20px;
}

/* Filter + sort bar */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}
.filter-pill {
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 13px;
  cursor: pointer;
  transition: all .18s;
  color: var(--muted2);
  background: transparent;
  border: 1px solid transparent;
  font-family: 'DM Sans', sans-serif;
}
.filter-pill:hover { color: var(--text); background: rgba(255,255,255,.05); }
.filter-pill.active {
  background: var(--teal-dim);
  color: var(--teal);
  border-color: rgba(45,212,191,.25);
}
.filter-sep { flex: 1; }
.sort-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--muted);
}
.sort-sel {
  display: flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,.07);
  border: 1px solid var(--border);
  color: var(--muted2);
  padding: 6px 12px;
  border-radius: 8px;
  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  cursor: pointer;
}
.view-toggle { display: flex; gap: 4px; }
.vt-btn {
  width: 32px; height: 32px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 8px; cursor: pointer; transition: all .18s;
  background: transparent;
  border: 1px solid transparent;
  color: var(--muted);
}
.vt-btn:hover, .vt-btn.active { background: rgba(255,255,255,.07); color: var(--text); border-color: var(--border); }

/* ─── Content ──────────────────────────────── */
#content {
  flex: 1;
  overflow-y: auto;
  padding: 24px 32px 32px;
}
#content::-webkit-scrollbar { width: 4px; }
#content::-webkit-scrollbar-thumb { background: rgba(255,255,255,.1); border-radius: 2px; }

/* Image grid */
#img-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
#img-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
#img-grid.cols-4 { grid-template-columns: repeat(4, 1fr); }

/* Card */
.img-card {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  cursor: pointer;
  background: var(--card);
  aspect-ratio: 16/10;
  transition: transform .25s cubic-bezier(.4,0,.2,1);
}
.img-card:hover { transform: translateY(-3px); }
.img-card:hover .card-img { filter: brightness(.75) saturate(1.1); }
.img-card:hover .card-menu { opacity: 1; }

.card-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: filter .3s;
  filter: brightness(.85);
}

.card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.2) 45%, transparent 70%);
  pointer-events: none;
}

.card-info {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 16px 18px;
}
.card-meta {
  font-size: 11px;
  color: rgba(255,255,255,.55);
  letter-spacing: .3px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.card-dot { width: 3px; height: 3px; background: rgba(255,255,255,.4); border-radius: 50%; }
.card-title {
  font-size: 15px;
  font-weight: 500;
  color: #fff;
  letter-spacing: -.1px;
  line-height: 1.3;
}

.card-menu {
  position: absolute;
  top: 12px; right: 12px;
  width: 30px; height: 30px;
  background: rgba(0,0,0,.5);
  backdrop-filter: blur(8px);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  opacity: 0;
  transition: opacity .2s;
  color: rgba(255,255,255,.8);
  font-size: 14px;
  letter-spacing: 1px;
}

/* Card placeholder */
.card-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: var(--card);
}
.mini-spin {
  width: 22px; height: 22px;
  border: 2px solid rgba(255,255,255,.08);
  border-top-color: var(--teal);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

/* States */
#loading-state {
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 40px;
  gap: 16px;
}
#loading-state.show { display: flex; }
.big-spin {
  width: 40px; height: 40px;
  border: 2px solid rgba(255,255,255,.06);
  border-top-color: var(--teal);
  border-radius: 50%;
  animation: spin .9s linear infinite;
}
.load-label { font-size: 13px; color: var(--muted); letter-spacing: .3px; }

#error-state {
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 40px;
  gap: 12px;
  text-align: center;
}
#error-state.show { display: flex; }
.err-icon {
  width: 48px; height: 48px;
  background: rgba(239,68,68,.1);
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 4px;
}
.err-title { font-size: 16px; font-weight: 500; color: var(--text); }
.err-msg { font-size: 13px; color: var(--muted); line-height: 1.8; max-width: 400px; white-space: pre-line; }
.err-actions { display: flex; gap: 10px; margin-top: 8px; flex-wrap: wrap; justify-content: center; }
.err-btn {
  padding: 8px 20px; border-radius: 10px; font-family: 'DM Sans', sans-serif;
  font-size: 13px; cursor: pointer; transition: all .18s;
}
.err-btn-primary { background: var(--teal); color: #0a1a18; font-weight: 600; border: none; }
.err-btn-primary:hover { background: #5eead4; }
.err-btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--muted2); }
.err-btn-ghost:hover { background: rgba(255,255,255,.05); color: var(--text); }

/* ─── API Key Modal ─────────────────────────── */
#setup-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.85);
  backdrop-filter: blur(8px);
  z-index: 500;
  display: flex; align-items: center; justify-content: center;
}
#setup-box {
  background: var(--sidebar);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 40px;
  max-width: 520px;
  width: 92%;
}
.modal-icon {
  width: 48px; height: 48px;
  background: var(--teal-dim);
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20px;
}
.modal-title { font-family: 'DM Serif Display', serif; font-size: 24px; color: var(--text); margin-bottom: 6px; }
.modal-sub { font-size: 13px; color: var(--muted); margin-bottom: 28px; line-height: 1.7; }
.modal-steps { display: flex; flex-direction: column; gap: 14px; margin-bottom: 28px; }
.modal-step { display: flex; gap: 14px; align-items: flex-start; }
.step-n {
  width: 24px; height: 24px; flex-shrink: 0;
  background: var(--teal-dim);
  border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 600; color: var(--teal);
}
.step-t { font-size: 13px; color: var(--muted2); line-height: 1.7; }
.step-t a { color: var(--teal); text-decoration: none; }
.step-t a:hover { text-decoration: underline; }
.step-t code { background: rgba(45,212,191,.1); color: var(--teal); padding: 1px 6px; border-radius: 4px; font-size: 12px; }
.modal-divider { height: 1px; background: var(--border); margin-bottom: 24px; }
.modal-label { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; display: block; }
#api-key-input {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 12px 16px;
  border-radius: 10px;
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  outline: none;
  transition: border-color .2s;
  margin-bottom: 8px;
}
#api-key-input:focus { border-color: rgba(45,212,191,.5); }
#api-key-input.err-input { border-color: rgba(239,68,68,.5); }
.modal-hint { font-size: 12px; color: var(--muted); margin-bottom: 20px; }
.modal-hint.red { color: #f87171; }
.modal-btns { display: flex; gap: 10px; }
.modal-btn-primary {
  flex: 1; background: var(--teal); border: none; color: #0a1a18;
  padding: 12px; border-radius: 10px; font-family: 'DM Sans', sans-serif;
  font-size: 14px; font-weight: 600; cursor: pointer; transition: all .18s;
}
.modal-btn-primary:hover { background: #5eead4; }
.modal-btn-ghost {
  background: transparent; border: 1px solid var(--border); color: var(--muted2);
  padding: 12px 20px; border-radius: 10px; font-family: 'DM Sans', sans-serif;
  font-size: 14px; cursor: pointer; transition: all .18s;
}
.modal-btn-ghost:hover { background: rgba(255,255,255,.05); color: var(--text); }

/* ─── Lightbox ──────────────────────────────── */
#lightbox {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.95);
  z-index: 999;
  display: none;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16px;
}
#lightbox.open { display: flex; }
#lb-img { max-width: 88vw; max-height: 80vh; object-fit: contain; border-radius: 12px; display: none; }
#lb-spin { width: 36px; height: 36px; border: 2px solid rgba(255,255,255,.1); border-top-color: var(--teal); border-radius: 50%; animation: spin .9s linear infinite; }
#lb-close {
  position: fixed; top: 20px; right: 24px;
  width: 36px; height: 36px;
  background: rgba(255,255,255,.1);
  border: none; border-radius: 10px;
  color: rgba(255,255,255,.7); font-size: 18px;
  cursor: pointer; transition: all .18s;
  display: flex; align-items: center; justify-content: center;
}
#lb-close:hover { background: rgba(255,255,255,.2); color: #fff; }
#lb-cap { font-size: 12px; color: rgba(255,255,255,.4); letter-spacing: .5px; text-align: center; max-width: 60vw; }
.lb-nav { display: flex; gap: 10px; }
.lb-btn {
  background: rgba(255,255,255,.1); border: none; color: rgba(255,255,255,.7);
  padding: 8px 20px; border-radius: 10px; font-family: 'DM Sans', sans-serif;
  font-size: 13px; cursor: pointer; transition: all .18s;
}
.lb-btn:hover { background: rgba(255,255,255,.2); color: #fff; }

@keyframes spin { to { transform: rotate(360deg); } }
.fade-in { animation: fi .35s ease both; }
@keyframes fi { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
</style>
</head>
<body>

<!-- ── API Key Modal ── -->
<div id="setup-overlay">
  <div id="setup-box">
    <div class="modal-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2dd4bf" stroke-width="2">
        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
      </svg>
    </div>
    <div class="modal-title">ตั้งค่า API Key</div>
    <div class="modal-sub">ใส่ Google Drive API Key เพื่อดึงภาพจาก Google Drive ได้โดยตรง<br>ตั้งค่าครั้งเดียว บันทึกในเครื่องของคุณ</div>

    <div class="modal-steps">
      <div class="modal-step">
        <div class="step-n">1</div>
        <div class="step-t">ไปที่ <a href="https://console.cloud.google.com/apis/library/drive.googleapis.com" target="_blank">Google Cloud Console</a> → เปิดใช้ <code>Google Drive API</code></div>
      </div>
      <div class="modal-step">
        <div class="step-n">2</div>
        <div class="step-t">ไปที่ <a href="https://console.cloud.google.com/apis/credentials" target="_blank">APIs & Services → Credentials</a> → <code>+ CREATE CREDENTIALS</code> → <code>API key</code></div>
      </div>
      <div class="modal-step">
        <div class="step-n">3</div>
        <div class="step-t">โฟลเดอร์ใน Drive ต้องตั้งเป็น <code>Anyone with the link → Viewer</code></div>
      </div>
    </div>

    <div class="modal-divider"></div>
    <label class="modal-label">Google Drive API Key</label>
    <input id="api-key-input" type="text" placeholder="AIzaSy...">
    <div class="modal-hint" id="key-hint">API Key บันทึกไว้ใน browser ของคุณเท่านั้น ไม่ได้ส่งไปที่ใด</div>
    <div class="modal-btns">
      <button class="modal-btn-ghost" onclick="skipSetup()">ข้ามก่อน</button>
      <button class="modal-btn-primary" onclick="saveApiKey()">เริ่มใช้งาน →</button>
    </div>
  </div>
</div>

<!-- ── Sidebar ── -->
<nav id="sidebar">
  <div class="sb-brand">
    <div class="sb-brand-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="3"/>
        <circle cx="8.5" cy="8.5" r="1.5" fill="white" stroke="none"/>
        <polyline points="21 15 16 10 5 21"/>
      </svg>
    </div>
    <span class="sb-brand-name">Horizon Gallery</span>
  </div>

  <div class="sb-section">
    <div class="sb-section-label">Collections</div>
    <div class="sb-item active" id="nc-all" onclick="filterCollection('all')">
      <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
        <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
      </svg>
      ทั้งหมด
    </div>
    <div class="sb-item" id="nc-bts" onclick="filterCollection('BTS')">
      <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
      </svg>
      BTS
    </div>
    <div class="sb-item" id="nc-ari" onclick="filterCollection('ARI HILLS')">
      <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
      </svg>
      Ari Hills
    </div>
    <div class="sb-item" id="nc-ksl" onclick="filterCollection('KSL')">
      <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
      </svg>
      KSL
    </div>
  </div>

  <div class="sb-divider"></div>

  <div class="sb-section">
    <div class="sb-section-label">Settings</div>
    <div class="sb-item" onclick="changeKey()">
      <svg class="sb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
      </svg>
      API Key
    </div>
  </div>

  <div class="sb-footer">
    <div class="sb-user" onclick="changeKey()">
      <div class="sb-avatar">H</div>
      <div>
        <div style="font-size:13px;color:var(--text);font-weight:500">Horizon</div>
        <div class="sb-username" id="api-status" style="font-size:11px">ตั้งค่า API Key</div>
      </div>
      <div class="sb-user-dots">···</div>
    </div>
  </div>
</nav>

<!-- ── Main ── -->
<div id="main">
  <div id="topbar">
    <div class="tb-head">
      <div class="tb-title">Horizon Gallery</div>
      <div class="tb-actions">
        <button class="btn-ghost" onclick="refreshAll()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/>
          </svg>
          โหลดใหม่
        </button>
        <button class="btn-primary" onclick="changeKey()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
          </svg>
          ตั้งค่า
        </button>
      </div>
    </div>
    <div class="tb-sub" id="tb-count">— photos</div>

    <div class="filter-bar">
      <button class="filter-pill active" id="fp-all"     onclick="filterCollection('all')">ทั้งหมด</button>
      <button class="filter-pill"        id="fp-bts"     onclick="filterCollection('BTS')">BTS</button>
      <button class="filter-pill"        id="fp-ari"     onclick="filterCollection('ARI HILLS')">Ari Hills</button>
      <button class="filter-pill"        id="fp-ksl"     onclick="filterCollection('KSL')">KSL</button>
      <div class="filter-sep"></div>
      <div class="sort-wrap">
        <span>แสดง</span>
        <div class="view-toggle">
          <button class="vt-btn active" id="vb2" onclick="setCols(2)" title="2 คอลัมน์">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="8" height="18" rx="1"/><rect x="13" y="3" width="8" height="18" rx="1"/></svg>
          </button>
          <button class="vt-btn" id="vb3" onclick="setCols(3)" title="3 คอลัมน์">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="4" height="18" rx="1"/><rect x="10" y="3" width="4" height="18" rx="1"/><rect x="17" y="3" width="4" height="18" rx="1"/></svg>
          </button>
          <button class="vt-btn" id="vb4" onclick="setCols(4)" title="4 คอลัมน์">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="4" height="18" rx="1"/><rect x="8" y="3" width="4" height="18" rx="1"/><rect x="14" y="3" width="4" height="18" rx="1"/><rect x="20" y="3" width="4" height="18" rx="1"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div id="content">
    <div id="loading-state">
      <div class="big-spin"></div>
      <div class="load-label">กำลังโหลดภาพ…</div>
    </div>
    <div id="error-state">
      <div class="err-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <div class="err-title">โหลดภาพไม่ได้</div>
      <div class="err-msg" id="err-msg"></div>
      <div class="err-actions">
        <button class="err-btn err-btn-primary" onclick="retryLoad()">↺ ลองใหม่</button>
        <button class="err-btn err-btn-ghost" onclick="changeKey()">⚙ เปลี่ยน API Key</button>
      </div>
    </div>
    <div id="img-grid"></div>
  </div>
</div>

<!-- ── Lightbox ── -->
<div id="lightbox">
  <button id="lb-close" onclick="closeLb()">✕</button>
  <div id="lb-spin"></div>
  <img id="lb-img" src="" alt="">
  <div id="lb-cap"></div>
  <div class="lb-nav">
    <button class="lb-btn" onclick="lbStep(-1)">← Prev</button>
    <button class="lb-btn" onclick="lbStep(1)">Next →</button>
  </div>
</div>

<script>
// ─── Config ───────────────────────────────────────────
const FOLDERS = {
  'BTS':       '1B-VcG8FsVsz_UbhW0IXdX9nZtDVcaitY',
  'ARI HILLS': '103JzXsKNa2NHd06siLz9lNxp8eVbm45H',
  'KSL':       '1mkiGys7mIcHn1Z8y-GP5D6J78EqF4Dxh',
};
const IMG_MIME = new Set(['image/jpeg','image/png','image/gif','image/webp','image/heic','image/bmp','image/tiff','image/svg+xml']);
const COL_LABELS = { 'BTS':'BTS', 'ARI HILLS':'Ari Hills', 'KSL':'KSL' };

// ─── State ────────────────────────────────────────────
let apiKey   = localStorage.getItem('gdrive_api_key') || '';
let cache    = {};          // folder → [{id,name,mimeType}]
let allFiles = [];          // merged [{id,name,collection}]
let curFiles = [];          // filtered
let curCol   = 'all';
let lbIdx    = 0;
let cols     = 2;

// ─── Init ─────────────────────────────────────────────
window.addEventListener('DOMContentLoaded', () => {
  if (apiKey) { closeSetup(); loadAll(); }
  else { document.getElementById('setup-overlay').style.display = 'flex'; }
  updateStatus();
});

// ─── Setup ────────────────────────────────────────────
function saveApiKey() {
  const v = document.getElementById('api-key-input').value.trim();
  if (!v || v.length < 20) {
    document.getElementById('api-key-input').classList.add('err-input');
    document.getElementById('key-hint').textContent = 'กรุณาใส่ API Key ให้ครบถ้วน';
    document.getElementById('key-hint').classList.add('red');
    return;
  }
  apiKey = v;
  localStorage.setItem('gdrive_api_key', v);
  cache = {}; allFiles = [];
  closeSetup(); updateStatus(); loadAll();
}
function closeSetup() { document.getElementById('setup-overlay').style.display = 'none'; }
function skipSetup()  { closeSetup(); }
function changeKey() {
  document.getElementById('api-key-input').value = apiKey;
  document.getElementById('api-key-input').classList.remove('err-input');
  document.getElementById('key-hint').textContent = 'API Key บันทึกไว้ใน browser ของคุณเท่านั้น';
  document.getElementById('key-hint').classList.remove('red');
  document.getElementById('setup-overlay').style.display = 'flex';
}
function updateStatus() {
  document.getElementById('api-status').textContent = apiKey ? 'API พร้อมใช้งาน ✓' : 'ยังไม่ได้ตั้งค่า';
}

// ─── Load all folders ─────────────────────────────────
async function loadAll() {
  if (!apiKey) return;
  showLoading();
  try {
    const results = await Promise.all(
      Object.entries(FOLDERS).map(([name, id]) => fetchFolder(name, id))
    );
    allFiles = results.flat();
    applyFilter(curCol);
  } catch(e) {
    showErr(e.message);
  }
}

async function fetchFolder(name, folderId) {
  let files = [], pageToken = '';
  do {
    const q   = encodeURIComponent(`'${folderId}' in parents and trashed=false`);
    const fld = encodeURIComponent('files(id,name,mimeType),nextPageToken');
    let url = `https://www.googleapis.com/drive/v3/files?q=${q}&fields=${fld}&pageSize=1000&key=${apiKey}`;
    if (pageToken) url += `&pageToken=${encodeURIComponent(pageToken)}`;

    const res = await fetch(url);
    if (!res.ok) {
      const e = await res.json().catch(() => ({}));
      const m = e.error?.message || `HTTP ${res.status}`;
      if (res.status === 400) throw new Error('API Key ไม่ถูกต้อง หรือ Drive API ยังไม่ได้ Enable\n' + m);
      if (res.status === 403) throw new Error('ไม่มีสิทธิ์เข้าถึง ตรวจสอบ:\n• API Key ถูกต้อง\n• Drive API ถูก Enable\n• โฟลเดอร์เป็น Public\n' + m);
      throw new Error(m);
    }

    const data = await res.json();
    const imgs = (data.files || []).filter(f => IMG_MIME.has(f.mimeType)).map(f => ({...f, collection: name}));
    files = files.concat(imgs);
    pageToken = data.nextPageToken || '';
  } while (pageToken);

  cache[name] = files;
  return files;
}

function refreshAll() { cache = {}; allFiles = []; loadAll(); }
function retryLoad()  { refreshAll(); }

// ─── Filter ───────────────────────────────────────────
function filterCollection(col) {
  curCol = col;

  // sidebar active
  ['all','bts','ari','ksl'].forEach(k => document.getElementById('nc-'+k)?.classList.remove('active'));
  const smap = {'all':'all','BTS':'bts','ARI HILLS':'ari','KSL':'ksl'};
  if (smap[col]) document.getElementById('nc-'+smap[col]).classList.add('active');

  // filter pills active
  ['fp-all','fp-bts','fp-ari','fp-ksl'].forEach(id => document.getElementById(id).classList.remove('active'));
  const pmap = {'all':'fp-all','BTS':'fp-bts','ARI HILLS':'fp-ari','KSL':'fp-ksl'};
  if (pmap[col]) document.getElementById(pmap[col]).classList.add('active');

  applyFilter(col);
}

function applyFilter(col) {
  curFiles = col === 'all' ? allFiles : allFiles.filter(f => f.collection === col);
  renderGrid(curFiles);
}

// ─── Render ───────────────────────────────────────────
function renderGrid(files) {
  hideStates();
  const grid = document.getElementById('img-grid');
  grid.innerHTML = '';

  const total = allFiles.length;
  document.getElementById('tb-count').textContent =
    total ? `${total} photos · แสดง ${files.length} รายการ` : '— photos';

  if (!files.length && allFiles.length === 0) {
    showErr('ไม่พบไฟล์ภาพ\nตรวจสอบว่าโฟลเดอร์ตั้งเป็น "Anyone with the link" และมีไฟล์ภาพอยู่');
    return;
  }
  if (!files.length) {
    grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:60px 0;color:var(--muted);font-size:14px">ไม่มีภาพใน collection นี้</div>`;
    return;
  }

  files.forEach((f, i) => {
    const card = document.createElement('div');
    card.className = 'img-card fade-in';
    card.style.animationDelay = Math.min(i * 0.04, 0.5) + 's';

    const dateStr = new Date().toLocaleDateString('th-TH', { day:'numeric', month:'short', year:'numeric' });

    card.innerHTML = `
      <div class="card-ph"><div class="mini-spin"></div></div>
      <div class="card-overlay"></div>
      <div class="card-info">
        <div class="card-meta">
          <span>${COL_LABELS[f.collection] || f.collection}</span>
          <span class="card-dot"></span>
          <span>${dateStr}</span>
        </div>
        <div class="card-title">${f.name.replace(/\.[^.]+$/, '')}</div>
      </div>
      <div class="card-menu">···</div>`;

    const img = new Image();
    img.onload = () => {
      card.querySelector('.card-ph')?.remove();
      img.className = 'card-img';
      card.insertBefore(img, card.firstChild);
    };
    img.onerror = () => {
      if (!img.src.includes('uc?export')) {
        img.src = `https://drive.google.com/uc?export=view&id=${f.id}`;
      } else {
        card.querySelector('.card-ph').innerHTML = `
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.1)" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>`;
      }
    };
    img.src = `https://drive.google.com/thumbnail?id=${f.id}&sz=w800`;
    img.alt = f.name;

    card.addEventListener('click', () => openLb(i));
    grid.appendChild(card);
  });
}

// ─── Columns ──────────────────────────────────────────
function setCols(n) {
  cols = n;
  [2,3,4].forEach(v => {
    document.getElementById('vb'+v).classList.toggle('active', v===n);
  });
  const grid = document.getElementById('img-grid');
  grid.className = n===2 ? 'img-grid' : `cols-${n}`;
  if (n===2) grid.style.gridTemplateColumns = 'repeat(2,1fr)';
  if (n===3) grid.style.gridTemplateColumns = 'repeat(3,1fr)';
  if (n===4) grid.style.gridTemplateColumns = 'repeat(4,1fr)';
}

// ─── States ───────────────────────────────────────────
function showLoading() {
  document.getElementById('img-grid').innerHTML = '';
  document.getElementById('loading-state').classList.add('show');
  document.getElementById('error-state').classList.remove('show');
  document.getElementById('tb-count').textContent = 'กำลังโหลด…';
}
function hideStates() {
  document.getElementById('loading-state').classList.remove('show');
  document.getElementById('error-state').classList.remove('show');
}
function showErr(msg) {
  document.getElementById('loading-state').classList.remove('show');
  document.getElementById('error-state').classList.add('show');
  document.getElementById('err-msg').innerText = msg;
}

// ─── Lightbox ─────────────────────────────────────────
function openLb(idx) {
  lbIdx = idx; document.getElementById('lightbox').classList.add('open'); loadLb();
}
function closeLb() { document.getElementById('lightbox').classList.remove('open'); }
function lbStep(d) { lbIdx = (lbIdx + d + curFiles.length) % curFiles.length; loadLb(); }
function loadLb() {
  const f = curFiles[lbIdx];
  const lbImg  = document.getElementById('lb-img');
  const lbSpin = document.getElementById('lb-spin');
  lbImg.style.display = 'none';
  lbSpin.style.display = 'block';
  const img = new Image();
  img.onload = () => { lbImg.src = img.src; lbImg.style.display = 'block'; lbSpin.style.display = 'none'; };
  img.onerror = () => {
    if (!img.src.includes('uc?export')) img.src = `https://drive.google.com/uc?export=view&id=${f.id}`;
    else lbSpin.style.display = 'none';
  };
  img.src = `https://drive.google.com/uc?export=view&id=${f.id}`;
  document.getElementById('lb-cap').textContent =
    `${COL_LABELS[f.collection]}  ·  ${f.name}  ·  ${lbIdx+1} / ${curFiles.length}`;
}
document.getElementById('lightbox').addEventListener('click', e => { if (e.target.id==='lightbox') closeLb(); });
document.addEventListener('keydown', e => {
  if (!document.getElementById('lightbox').classList.contains('open')) return;
  if (e.key==='Escape') closeLb();
  if (e.key==='ArrowLeft') lbStep(-1);
  if (e.key==='ArrowRight') lbStep(1);
});
</script>
</body>
</html>
